    "fileIdentity": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "platform",
            "device",
            "inode"
          ],
          "properties": {
            "platform": {
              "const": "posix"
            },
            "device": {
              "type": "string",
              "maxLength": 20,
              "pattern": "^(?:0|[1-9][0-9]{0,19})$(?![\\s\\S])"
            },
            "inode": {
              "type": "string",
              "maxLength": 20,
              "pattern": "^(?:[1-9][0-9]{0,19})$(?![\\s\\S])"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "platform",
            "volume",
            "fileId"
