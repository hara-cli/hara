          "properties": {
            "path": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^(?:[^\\x00-\\x1f\\x7f-\\x9f\\ud800-\\udfff]+)$(?![\\s\\S])"
            },
            "fileIdentity": {
              "$ref": "#/$defs/fileIdentity"
            }
          }
        },
        "token": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
