        },
        "agentId": {
          "$ref": "#/$defs/agentId"
        },
        "instanceId": {
          "$ref": "#/$defs/uuid"
        },
        "launchRef": {
          "$ref": "#/$defs/uuid"
        },
        "policyDigest": {
          "$ref": "#/$defs/digest"
        },
        "connectionId": {
          "$ref": "#/$defs/uuid"
        },
        "from": {
          "type": "string",
          "maxLength": 46,
          "pattern": "^(?:agent-ext_(codex|claude|opencode|runtime)_[a-f0-9]{24})$(?![\\s\\S])"
        },
        "grantEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "materialRoot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resourceId",
            "revision",
            "path",
            "fileIdentity"
          ],
          "properties": {
            "resourceId": {
              "type": "string",
              "maxLength": 160,
              "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.:-]{0,159})$(?![\\s\\S])"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "path": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^(?:[^\\x00-\\x1f\\x7f-\\x9f\\ud800-\\udfff]+)$(?![\\s\\S])"
            },
            "fileIdentity": {
              "$ref": "#/$defs/fileIdentity"
            }
          }
        },
        "recoveryRoot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
