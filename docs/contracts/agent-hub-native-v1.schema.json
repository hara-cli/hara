          "properties": {
            "platform": {
              "const": "win32"
            },
            "volume": {
              "type": "string",
              "maxLength": 16,
              "pattern": "^(?:[a-f0-9]{16})$(?![\\s\\S])"
            },
            "fileId": {
              "type": "string",
              "maxLength": 32,
              "pattern": "^(?:[a-f0-9]{32})$(?![\\s\\S])"
            }
          }
        }
      ]
