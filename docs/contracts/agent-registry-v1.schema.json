{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schemaVersion",
    "binding",
    "source",
    "availability",
    "revision",
    "capturedAt",
    "agents",
    "error"
  ],
  "properties": {
    "contract": {
      "const": "hara.agent-registry.v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "binding": {
      "$ref": "#/$defs/binding"
    },
    "source": {
      "const": "core-managed"
    },
    "availability": {
      "enum": [
        "available",
        "unavailable"
      ]
    },
    "revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$"
    },
    "agents": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/agent"
      }
    },
    "error": {
      "enum": [
        null,
        "registry_unavailable"
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hara:agent-registry:v1",
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "scopeKey",
        "generation"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "scopeKey": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "generation": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentId",
        "instanceId",
        "alias",
        "displayName",
        "engine",
        "sessionSource",
        "createdAt",
        "registeredAt",
        "lifecycle",
        "state"
      ],
      "properties": {
        "agentId": {
          "type": "string",
          "pattern": "^ext_(codex|claude|opencode|runtime)_[a-f0-9]{24}$"
        },
        "instanceId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "alias": {
          "type": "string",
          "pattern": "^agent-ext_(codex|claude|opencode|runtime)_[a-f0-9]{24}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "x-maxUtf16CodeUnits": 160,
          "pattern": "^[^\\u0000-\\u001f\\u007f\\u202a-\\u202e\\u2066-\\u2069]+$",
          "x-unicodeScalarValues": true
        },
        "engine": {
          "enum": [
            "codex",
            "claude",
            "opencode"
          ]
        },
        "sessionSource": {
          "enum": [
            "codex",
            "claude",
            "opencode",
            "runtime"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$"
        },
        "registeredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$"
        },
        "lifecycle": {
          "enum": [
            "registered",
            "ended",
            "unknown"
          ]
        },
        "state": {
          "const": "unknown"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sessionSource": {
                "const": "codex"
              }
            }
          },
          "then": {
            "properties": {
              "agentId": {
                "pattern": "^ext_codex_"
              },
              "engine": {
                "const": "codex"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "sessionSource": {
                "const": "claude"
              }
            }
          },
          "then": {
            "properties": {
              "agentId": {
                "pattern": "^ext_claude_"
              },
              "engine": {
                "const": "claude"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "sessionSource": {
                "const": "opencode"
              }
            }
          },
          "then": {
            "properties": {
              "agentId": {
                "pattern": "^ext_opencode_"
              },
              "engine": {
                "const": "opencode"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "sessionSource": {
                "const": "runtime"
              }
            }
          },
          "then": {
            "properties": {
              "agentId": {
                "pattern": "^ext_runtime_"
              },
              "engine": {
                "enum": [
                  "codex",
                  "claude"
                ]
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "availability": {
            "const": "available"
          }
        }
      },
      "then": {
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "error": {
            "const": null
          }
        }
      },
      "else": {
        "properties": {
          "revision": {
            "const": null
          },
          "error": {
            "const": "registry_unavailable"
          },
          "agents": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "description": "Syntax only. Also enforce normative identity relations, distinct agent IDs, UTF-16 label bounds, canonical calendar timestamps and a 262144-byte UTF-8 encoded snapshot limit; see agent-registry-v1.md."
}
